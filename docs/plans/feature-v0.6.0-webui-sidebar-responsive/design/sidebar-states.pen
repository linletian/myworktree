          "fontFamily": "Inter",
          "fontSize": 12,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "o2CVTn",
          "name": "说明",
          "fill": "$text-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
