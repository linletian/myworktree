          ]
        },
        {
          "type": "text",
          "id": "qk0020",
          "name": "标注",
          "fill": "$anno",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "▲ 新入口 = DOM 首子元素，视觉在 Refresh 之上（R18）",
          "lineHeight": 1.4,
